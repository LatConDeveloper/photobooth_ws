{
  "name": "photobooth-server",
  "version": "1.0.0",
  "description": "PhotoBooth backend with Hono and Supabase",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "photobooth",
    "hono",
    "supabase"
